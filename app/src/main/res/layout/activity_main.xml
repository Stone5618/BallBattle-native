<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <com.ballbattle.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 模式选择按钮容器 -->
    <LinearLayout
        android:id="@+id/btn_mode_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="球球大作战"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:shadowColor="#40000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="20dp" />

        <!-- 段位和金币卡片 -->
        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <!-- 段位显示 -->
            <TextView
                android:id="@+id/tv_rank_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="段位: 青铜III  0/3\u2605"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:layout_marginBottom="6dp" />

            <!-- 金币显示 -->
            <TextView
                android:id="@+id/tv_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coins_display"
                android:textSize="16sp"
                android:textColor="#FFD700" />
        </LinearLayout>

        <!-- 模式按钮 - 横向排列 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_free"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="自由模式"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_free_bg"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_survival"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="生存模式"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_survival_bg"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_battle"
                android:layout_width="110dp"
                android:layout_height="50dp"
                android:text="大逃杀"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_battle_bg"
                android:stateListAnimator="@null"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- 底部功能按钮 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <Button
                android:id="@+id/btn_skin"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:text="@string/skin_shop"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_checkin"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:text="@string/check_in"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_rank"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:text="@string/rank"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_bg"
                android:stateListAnimator="@null"
                android:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
